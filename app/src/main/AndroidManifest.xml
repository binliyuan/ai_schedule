<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WakeupScheduleApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WakeupSchedule">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WakeupSchedule">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HomeActivity"
            android:theme="@style/Theme.WakeupSchedule" />

        <activity
            android:name=".ui.manage.CourseManageActivity"
            android:theme="@style/Theme.WakeupSchedule" />

        <activity
            android:name=".ui.camera.AiCameraActivity"
            android:theme="@style/Theme.WakeupSchedule" />

        <activity
            android:name=".ui.gallery.GalleryImportActivity"
            android:theme="@style/Theme.WakeupSchedule" />

        <service
            android:name=".mcp.McpService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name=".service.ScheduleNotificationService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent notification showing current university class schedule with countdown timer" />
        </service>
    </application>

</manifest>
